"_component_Lock","confirm","_component_el_radio","role","label","_cache","_createBlock","authorize","_hoisted_2","validCode","_component_ValidCode","onInput","$options","createValidCode","_component_el_button","type","onClick","register","_ctx","$router","push"],"sources":["E:\\zhoumian\\大三上\\JavaEE\\课设\\Vue-Springboot-Library-main\\vue\\src\\views\\Register.vue"],"sourcesContent":["<template>\n<div  class=\"login-container\"  >\n    <el-form ref=\"form\" :model=\"form\"    :rules=\"rules\" class=\"login-page\">\n      <h2 class=\"title\" style=\"margin-bottom: 20px\">用户注册</h2>\n      <el-form-item prop=\"username\" >\n        <el-input v-model=\"form.username\" placeholder=\"请输入用户名\" clearable >\n          <template #prefix>\n            <el-icon class=\"el-input__icon\"><User/></el-icon>\n          </template>\n        </el-input>\n      </el-form-item>\n      <el-form-item prop=\"password\">\n        <el-input v-model=\"form.password\"  placeholder=\"请输入密码\" clearable show-password>\n          <template #prefix>\n            <el-icon class=\"el-input__icon\"><Lock /></el-icon>\n          </template>\n        </el-input>\n      </el-form-item>\n      <el-form-item prop=\"confirm\">\n        <el-input v-model=\"form.confirm\" placeholder=\"请再次确认密码\" clearable show-password>\n          <template #prefix>\n            <el-icon class=\"el-input__icon\"><Lock /></el-icon>\n          </template>\n        </el-input>\n      </el-form-item>\n      <el-form-item prop=\"role\">\n        <el-radio v-model=\"form.role\" label=\"2\">读者</el-radio>\n        <el-radio v-model=\"form.role\" label=\"1\">管理员</el-radio>\n      </el-form-item>\n      <el-form-item prop=\"authorize\" v-if=\"form.role==1\">\n        <el-input v-model=\"form.authorize\" placeholder=\"请输入管理员注册码\" clearable show-password>\n          <template #prefix>\n            <el-icon class=\"el-input__icon\"><Lock /></el-icon>\n          </template>\n        </el-input>\n      </el-form-item>\n      <el-form-item>\n        <div style=\"display: flex\">\n          <el-input  v-model=\"form.validCode\" style=\"width: 45%;\" placeholder=\"请输入验证码\"></el-input>\n          <ValidCode @input=\"createValidCode\" style=\"width: 50%\"/>\n        </div>\n      </el-form-item>\n      <el-form-item >\n        <el-button type=\"primary\" style=\" width: 100%\" @click=\"register\">注 册</el-button>\n      </el-form-item>\n      <el-form-item><el-button type=\"text\" @click=\"$router.push('/login')\">前往登录>> </el-button></el-form-item>\n    </el-form>\n</div>\n\n</template>\n\n<script>\nimport request from \"../utils/request\";\nimport {ElMessage} from \"element-plus\";\nimport ValidCode from \"../components/Validate\";\nexport default {\n  name: \"Login\",\n  components:{\n    ValidCode\n  },\n  data(){\n    return{\n      form:{},\n      validCode: '',\n      rules: {\n        username: [\n          {\n            required: true,\n            message: '请输入用户名',\n            trigger: 'blur',\n          },\n          {\n            min: 2,\n            max: 13,\n            message: '长度要求为2到13位',\n            trigger: 'blur',\n          },\n        ],\n        password: [\n          {\n            required: true,\n            message: '请输入密码',\n            trigger: 'blur',\n          }\n        ],\n      confirm:[\n        {\n          required:true,\n          message:\"请确认密码\",\n          trigger:\"blur\"\n        }\n      ],\n        authorize:[\n          {\n            required:true,\n            message:\"请输入注册码\",\n            trigger:\"blur\"\n          }\n        ],\n      }\n    }\n    },\n\n  methods:{\n    createValidCode(data){\n      this.validCode =data\n    },\n    register(){\n      this.$refs['form'].validate((valid) => {\n        if (valid) {\n          if (!this.form.validCode) {\n            ElMessage.error(\"请填写验证码\")\n            return\n          }\n          if(this.form.validCode.toLowerCase() !== this.validCode.toLowerCase()) {\n            ElMessage.error(\"验证码错误\")\n            return\n          }\n          if(this.form.password != this.form.confirm)\n          {\n            ElMessage.error(\"两次密码输入不一致\")\n            return\n          }\n          if(this.form.role == 1 && this.form.authorize != \"1234\")\n          {\n            ElMessage.error(\"请输入正确的注册码\")\n            return\n          }\n          request.post(\"user/register\",this.form).then(res=>{\n            if(res.code == 0)\n            {\n              ElMessage.success(\"注册成功\")\n              this.$router.push(\"/login\")\n            }\n            else {ElMessage.error(res.msg)}\n          })\n        }\n      })\n\n    }\n  }\n\n  }\n\n</script>\n\n<style scoped>\n.login-container {\n  position: fixed;\n  width: 100%;\n  height: 100%;\n  background: url('../img/bg2.svg');\n  background-size: contain;\n}\n.login-page {\n  border-radius: 5px;\n  margin: 180px auto;\n  width: 350px;\n  padding: 35px 35px 15px;\n  background: #fff;\n  border: 1px solid #eaeaea;\n  box-shadow: 0 0 25px #cac6c6;\n}\n</style>"],"mappings":";;;EACMA,KAAK,EAAC;AAAiB;;EAoChBC,KAAqB,EAArB;IAAA;EAAA;AAAqB;;;;;;;;;;;uBApClCC,mBAAA,CA8CM,OA9CNC,UA8CM,GA7CFC,YAAA,CA4CUC,kBAAA;IA5CDC,GAAG,EAAC,MAAM;IAAEC,KAAK,EAAEC,KAAA,CAAAC,IAAI;IAAMC,KAAK,EAAEF,KAAA,CAAAE,KAAK;IAAEV,KAAK,EAAC;;sBACxD,MAAuD,C,4BAAvDW,mBAAA,CAAuD;MAAnDX,KAAK,EAAC,OAAO;MAACC,KAA2B,EAA3B;QAAA;MAAA;OAA4B,MAAI,qBAClDG,YAAA,CAMeQ,uBAAA;MANDC,IAAI,EAAC;IAAU;wBAC3B,MAIW,CAJXT,YAAA,CAIWU,mBAAA;oBAJQN,KAAA,CAAAC,IAAI,CAACM,QAAQ;mEAAbP,KAAA,CAAAC,IAAI,CAACM,QAAQ,GAAAC,MAAA;QAAEC,WAAW,EAAC,QAAQ;QAACC,SAAS,EAAT;;QAC1CC,MAAM,EAAAC,QAAA,CACf,MAAiD,CAAjDhB,YAAA,CAAiDiB,kBAAA;UAAxCrB,KAAK,EAAC;QAAgB;4BAAC,MAAO,CAAPI,YAAA,CAAOkB,eAAA,E;;;;;;QAI7ClB,YAAA,CAMeQ,uBAAA;MANDC,IAAI,EAAC;IAAU;wBAC3B,MAIW,CAJXT,YAAA,CAIWU,mBAAA;oBAJQN,KAAA,CAAAC,IAAI,CAACc,QAAQ;mEAAbf,KAAA,CAAAC,IAAI,CAACc,QAAQ,GAAAP,MAAA;QAAGC,WAAW,EAAC,OAAO;QAACC,SAAS,EAAT,EAAS;QAAC,eAAa,EAAb;;QACpDC,MAAM,EAAAC,QAAA,CACf,MAAkD,CAAlDhB,YAAA,CAAkDiB,kBAAA;UAAzCrB,KAAK,EAAC;QAAg